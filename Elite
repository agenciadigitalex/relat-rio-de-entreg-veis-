import requests
import json
from datetime import datetime
from collections import defaultdict

NOTION_TOKEN = "seu_token_aqui"
DATABASE_ID = "3a088bc5-b52d-8054-9724-000ba5d78160"

def calcular_metricas(tarefas):
    status_count = defaultdict(int)
    fase_status = defaultdict(lambda: defaultdict(int))
    
    for tarefa in tarefas:
        status = tarefa.get("properties", {}).get("Status", "Não iniciada")
        fase = tarefa.get("properties", {}).get("Fase", "Sem fase")
        
        status_count[status] += 1
        fase_status[fase][status] += 1
    
    total = sum(status_count.values())
    concluido = status_count.get("Concluído", 0)
    em_andamento = status_count.get("Em andamento", 0)
    
    progresso = round(((concluido + em_andamento) / total * 100), 1) if total > 0 else 0
    
    return {
        "total_tarefas": total,
        "concluido": concluido,
        "em_andamento": em_andamento,
        "nao_iniciada": status_count.get("Não iniciada", 0),
        "pausado": status_count.get("Pausado", 0),
        "taxa_progresso_percentual": progresso,
        "por_fase": dict(fase_status),
        "timestamp": datetime.now().isoformat()
    }

def fetch_notion_data():
    headers = {
        "Authorization": f"Bearer {NOTION_TOKEN}",
        "Notion-Version": "2022-06-28"
    }
    
    url = f"https://api.notion.com/v1/databases/{DATABASE_ID}/query"
    
    try:
        response = requests.post(url, headers=headers, json={})
        response.raise_for_status()
        return response.json().get("results", [])
    except requests.exceptions.RequestException as e:
        return {"erro": f"Falha ao conectar com Notion: {str(e)}"}

def gerar_relatorio(tarefas):
    metricas = calcular_metricas(tarefas)
    
    tarefas_criticas = []
    for tarefa in tarefas:
        props = tarefa.get("properties", {})
        status = props.get("Status")
        titulo = props.get("Tarefa", "Tarefa sem título")
        data_inicio = props.get("date:Início:start")
        
        if status == "Não iniciada" and "SEMANA" in str(titulo).upper():
            tarefas_criticas.append({
                "tarefa": titulo,
                "status": status,
                "data": data_inicio,
                "severidade": "crítica"
            })
    
    return {
        "projeto": "Elite Funil de Vendas e Marketing",
        "data_relatorio": datetime.now().isoformat(),
        "metricas": metricas,
        "tarefas_criticas": tarefas_criticas[:5],
        "fase_atual": "01. Preparação das metodologias",
        "data_reuniao_final": "2026-09-14"
    }

def handler(request):
    headers = {
        "Content-Type": "application/json",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST",
        "Cache-Control": "max-age=300"
    }
    
    try:
        tarefas = fetch_notion_data()
        
        if isinstance(tarefas, dict) and "erro" in tarefas:
            return {
                "statusCode": 500,
                "headers": headers,
                "body": json.dumps(tarefas)
            }
        
        relatorio = gerar_relatorio(tarefas)
        
        return {
            "statusCode": 200,
            "headers": headers,
            "body": json.dumps(relatorio, ensure_ascii=False, indent=2)
        }
    
    except Exception as e:
        return {
            "statusCode": 500,
            "headers": headers,
            "body": json.dumps({"erro": str(e)})
        }
